{
  "manifest_version": 3,
  "name": "页面采集器",
  "version": "0.3.1",
  "description": "持续记录当前标签页，分次保存整页截图、Fetch/XHR JSON 和备注。",
  "minimum_chrome_version": "105",
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "采集当前页面",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "打开页面采集器"
    }
  }
}
